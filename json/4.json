 "infixes": [
  {
   "text": "-i-",
   "meaning": "Dual: exatamente dois. Fica entre a raiz e o sufixo de caso."
  },
  {
   "text": "-a-",
   "meaning": "Plural: três ou mais. Fica entre a raiz e o sufixo de caso."
  }
 ],
 "suffixes": [
  {
   "text": "-r",
   "meaning": "sujeito, exemplo vael-r (o lobo [faz algo])"
  },
  {
   "text": "-en",
   "meaning": "objeto, exemplo Vael*r Kaelen* = \"O lobo [pegou/quebrou/usou] a espada"
  },
  {
   "text": "-m",
   "meaning": "Genitivo, substitui \"de\", \"do\", \"da\". Indica dono, criador ou de onde algo veio. Kael Vaelm = \"A espada do lobo"
  },
  {
   "text": "-al",
   "meaning": "Dativo / Direção, exemplo Vaelal (Para o lobo). Kael Vaelal = \"A espada [é/foi dada] para o lobo"
  },
  {
   "text": "-k",
   "meaning": "Locativo / Instrumental, exemplo  Kaelk (Com a espada / Na espada)Vael*r Kaelk* = \"O lobo [caça/luta] com a espada\" (ou \"O lobo está na espada\", o contexto da história dirá qual dos dois)."
  }
 ],
 "phonology": [
  {
   "name": "W → U",
   "description": "O \"w\" no fim da raiz vira \"u\" antes de receber sufixo/infixo.",
   "example": "perkw + -m → perkum"
  },
  {
   "name": "Y → I",
   "description": "O \"y\" no fim da raiz vira \"i\" antes de receber sufixo/infixo.",
   "example": "viy + -k → viik"
  },
  {
   "name": "Vogal de eco (epêntese)",
   "description": "Se a raiz termina em consoante e o sufixo começa com consoante, insere-se uma cópia da última vogal da raiz.",
   "example": "bhég + -k → bhégék"
  }
 ],
 "syntax": [
  {
   "name": "Ordem padrão (SVO)",
   "description": "A ordem neutra é Sujeito — Verbo — Objeto. Os sufixos de caso permitem inverter para dar ênfase.",
   "example": "Égor vobhég bhégen."
  },
  {
   "name": "Concordância opcional do adjetivo",
   "description": "O adjetivo normalmente fica \"limpo\" junto do substantivo; só recebe sufixo de caso para destacá-lo.",
   "example": "bel perkw → belen perkwen (ênfase)"
  }
 ]
